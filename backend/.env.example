PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://user:password@host/dbname
DIRECT_URL=postgresql://user:password@host/dbname
INNGEST_DEV=1
BETTER_AUTH_SECRET=replace-with-at-least-32-character-random-secret
BETTER_AUTH_URL=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=replace-with-at-least-32-character-webhook-secret
SCAN_MAX_ARCHIVE_MB=50
SCAN_MAX_FILES=20000
SCAN_MAX_FILE_KB=512
SCAN_TIMEOUT_MS=300000
GITLEAKS_BIN=gitleaks
SEMGREP_BIN=semgrep
SEMGREP_CONFIG=p/default
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AI_MODEL_GROQ=llama-3.3-70b-versatile
AI_MODEL_GEMINI=gemini-2.0-flash
AI_MODEL_OPENROUTER=google/gemini-2.0-flash-001
AI_PROVIDER_ORDER=groq,gemini,openrouter
AI_MAX_CALLS_PER_WORKSPACE_PER_DAY=20
AI_MAX_CALLS_GLOBAL_PER_DAY=300
AI_REQUEST_TIMEOUT_MS=25000

