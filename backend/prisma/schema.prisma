generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                  String               @id
  name                String
  slug                String
  logo                String?
  createdAt           DateTime
  metadata            String?
  members             Member[]
  invitations         Invitation[]
  repositories        Repository[]
  githubInstallations GithubInstallation[]
  scans               Scan[]
  findings            Finding[]
  findingInsights     FindingInsight[]
  fixProposals        FixProposal[]
  aiUsages            AiUsage[]
  aiEnabled           Boolean              @default(false)
  aiEnabledBy         String?
  aiEnabledAt         DateTime?
  billingSubscription BillingSubscription?
  billingPayments     BillingPayment[]
  sandboxEnabled      Boolean              @default(false)
  sandboxEnabledBy    String?
  sandboxEnabledAt    DateTime?
  fixValidations      FixValidation[]
  sandboxUsages       SandboxUsage[]
  pullRequests        PullRequest[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

enum RepoProvider {
  GITHUB
}

enum RepoStatus {
  AVAILABLE
  CONNECTED
  DISCONNECTED
  REMOVED
}

enum GithubAccountType {
  User
  Organization
}

enum GithubRepositorySelection {
  ALL
  SELECTED
}

model GithubInstallation {
  id                  String                    @id @default(cuid())
  workspaceId         String
  workspace           Organization              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installationId      BigInt                    @unique
  accountLogin        String
  accountType         GithubAccountType
  accountId           BigInt
  repositorySelection GithubRepositorySelection
  htmlUrl             String
  suspendedAt         DateTime?
  lastSyncedAt        DateTime?
  permissions         Json?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  repositories        Repository[]

  @@index([workspaceId])
  @@map("github_installation")
}

model Repository {
  id             String             @id @default(cuid())
  workspaceId    String
  workspace      Organization       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installationId String
  installation   GithubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  provider       RepoProvider
  externalId     String
  fullName       String
  defaultBranch  String
  isPrivate      Boolean
  status         RepoStatus         @default(AVAILABLE)
  lastPushAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  scans          Scan[]
  findings       Finding[]
  pullRequests   PullRequest[]

  @@unique([workspaceId, provider, externalId])
  @@index([workspaceId])
  @@index([installationId])
  @@map("repository")
}

enum WebhookDeliveryStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum ScanTrigger {
  PUSH
  MANUAL
}

enum ScanStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

// TODO(retention): Delete webhook_delivery rows older than 30 days via scheduled cleanup job.
model WebhookDelivery {
  id             String                @id @default(cuid())
  deliveryId     String                @unique
  event          String
  action         String?
  installationId BigInt?
  status         WebhookDeliveryStatus @default(RECEIVED)
  ignoreReason   String?
  receivedAt     DateTime              @default(now())
  processedAt    DateTime?

  @@index([receivedAt])
  @@map("webhook_delivery")
}

model Scan {
  id           String       @id @default(cuid())
  workspaceId  String
  workspace    Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repositoryId String
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  branch       String
  commitSha    String
  trigger      ScanTrigger
  status       ScanStatus   @default(QUEUED)
  phase        String?
  progress     Int          @default(0)
  filesScanned Int?
  findingsCount Int         @default(0)
  durationMs   Int?
  analyzers    Json?
  errorCode    String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt

  @@unique([repositoryId, commitSha])
  @@index([workspaceId])
  @@index([repositoryId])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("scan")
}

enum FindingSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum FindingCategory {
  SECURITY
  BUG
  PERFORMANCE
  QUALITY
  SECRET
}

enum FindingTool {
  ESLINT
  SEMGREP
  GITLEAKS
}

enum FindingStatus {
  OPEN
  ACCEPTED
  REJECTED
  FIXED
}

model Finding {
  id           String          @id @default(cuid())
  workspaceId  String
  workspace    Organization    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repositoryId String
  repository   Repository      @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  firstScanId  String
  lastScanId   String
  fingerprint  String
  tool         FindingTool
  ruleId       String
  severity     FindingSeverity
  category     FindingCategory
  title        String
  message      String
  filePath     String
  startLine    Int
  endLine      Int
  snippet      String?
  status       FindingStatus   @default(OPEN)
  firstSeenAt  DateTime        @default(now())
  lastSeenAt   DateTime        @default(now())
  resolvedAt   DateTime?
  insights     FindingInsight[]
  fixProposals FixProposal[]
  pullRequests PullRequest[]

  @@unique([repositoryId, fingerprint])
  @@index([workspaceId])
  @@index([repositoryId])
  @@index([workspaceId, status, severity])
  @@index([repositoryId, status])
  @@map("finding")
}

model FindingInsight {
  id            String       @id @default(cuid())
  workspaceId   String
  workspace     Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  findingId     String
  finding       Finding      @relation(fields: [findingId], references: [id], onDelete: Cascade)
  promptVersion String
  contentHash   String
  summary       String
  whyItMatters  String
  howToFix      String
  provider      String
  model         String
  redacted      Boolean      @default(false)
  createdAt     DateTime     @default(now())

  @@unique([findingId, promptVersion])
  @@index([workspaceId])
  @@map("finding_insight")
}

enum FixProposalStatus {
  DRAFT
  DISCARDED
  INVALID
}

enum FixProposalConfidence {
  LOW
  MEDIUM
  HIGH
}

model FixProposal {
  id              String                @id @default(cuid())
  workspaceId     String
  workspace       Organization          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  findingId       String
  finding         Finding               @relation(fields: [findingId], references: [id], onDelete: Cascade)
  status          FixProposalStatus     @default(DRAFT)
  filePath        String
  startLine       Int
  endLine         Int
  originalCode    String
  replacementCode String
  diff            String
  explanation     String
  confidence      FixProposalConfidence
  checks          Json
  provider        String
  model           String
  promptVersion   String
  createdByUserId String
  createdAt       DateTime              @default(now())
  validations     FixValidation[]
  pullRequest     PullRequest?

  @@index([workspaceId])
  @@index([findingId])
  @@map("fix_proposal")
}

enum FixValidationStatus {
  QUEUED
  RUNNING
  PASSED
  PASSED_WITH_WARNINGS
  FAILED
  ERROR
}

model FixValidation {
  id              String              @id @default(cuid())
  workspaceId     String
  workspace       Organization        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fixProposalId   String
  fixProposal     FixProposal         @relation(fields: [fixProposalId], references: [id], onDelete: Cascade)
  status          FixValidationStatus @default(QUEUED)
  riskLevel       String?
  staticChecks    Json?
  testsRequested  Boolean             @default(false)
  testsRun        Boolean             @default(false)
  testSteps       Json?
  nodeVersion     String?
  errorCode       String?
  createdByUserId String
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime            @default(now())

  @@index([workspaceId])
  @@index([fixProposalId])
  @@index([fixProposalId, createdAt(sort: Desc)])
  @@map("fix_validation")
}

model SandboxUsage {
  id          String        @id @default(cuid())
  workspaceId String?
  workspace   Organization? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  day         DateTime      @db.Date
  runs        Int           @default(0)
  seconds     Int           @default(0)

  @@unique([workspaceId, day])
  @@index([workspaceId])
  @@map("sandbox_usage")
}

model AiUsage {
  id          String        @id @default(cuid())
  workspaceId String?
  workspace   Organization? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  day         DateTime      @db.Date
  calls       Int           @default(0)
  tokensIn    Int           @default(0)
  tokensOut   Int           @default(0)

  @@unique([workspaceId, day])
  @@index([workspaceId])
  @@map("ai_usage")
}

enum PullRequestStatus {
  CREATING
  OPEN
  MERGED
  CLOSED
  FAILED
}

model PullRequest {
  id              String            @id @default(cuid())
  workspaceId     String
  workspace       Organization      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repositoryId    String
  repository      Repository        @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  findingId       String
  finding         Finding           @relation(fields: [findingId], references: [id], onDelete: Cascade)
  fixProposalId   String            @unique
  fixProposal     FixProposal       @relation(fields: [fixProposalId], references: [id], onDelete: Cascade)
  validationId    String?
  githubNumber    Int?
  htmlUrl         String?
  branchName      String
  baseBranch      String
  headSha         String?
  title           String
  status          PullRequestStatus @default(CREATING)
  errorCode       String?
  riskLevel       String            @default("LOW")
  testsRun        Boolean           @default(false)
  mergedAt        DateTime?
  mergedByUserId  String?
  closedAt        DateTime?
  createdByUserId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  lastSyncedAt    DateTime?

  @@unique([repositoryId, githubNumber])
  @@index([workspaceId])
  @@index([repositoryId])
  @@index([findingId])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("pull_request")
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorUserId String?
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("audit_log")
}

model BillingSubscription {
  id                     String       @id @default(cuid())
  workspaceId            String       @unique
  workspace              Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  razorpaySubscriptionId String       @unique
  razorpayPlanId         String
  planKey                String
  status                 String
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean      @default(false)
  graceUntil             DateTime?
  createdByUserId        String
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  lastSyncedAt           DateTime?

  @@index([workspaceId])
  @@map("billing_subscription")
}

model BillingPayment {
  id                     String       @id @default(cuid())
  workspaceId            String
  workspace              Organization @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  razorpayPaymentId      String       @unique
  razorpaySubscriptionId String?
  amount                 Int
  currency               String
  status                 String
  paidAt                 DateTime?
  createdAt              DateTime     @default(now())

  @@index([workspaceId])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("billing_payment")
}

model BillingEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  event       String
  status      String
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@map("billing_event")
}

